DATABASE_URL=postgresql://postgres:password@localhost:5432/disaster_response
SECRET_KEY=your-secret-key-change-in-production
ENVIRONMENT=development
GDACS_API_URL=https://www.gdacs.org/xml/rss.xml
USGS_EARTHQUAKE_API_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# PostgreSQL/PostGIS Setup Instructions
# ============================================================
# 1. Install PostgreSQL for Windows:
#    - Download from: https://www.postgresql.org/download/windows/
#    - Run the installer, note the password for the 'postgres' user
#    - During installation, select the PostgreSQL data directory location
#
# 2. Install PostGIS extension:
#    - After PostgreSQL is installed, open pgAdmin or psql
#    - Run: CREATE EXTENSION IF NOT EXISTS POSTGIS;
#    - In pgAdmin: Right-click your database -> Properties -> Extensions -> Add -> POSTGIS
#
# 3. Create the database:
#    - CREATE DATABASE disaster_response;
#    - Connect to the database and run: CREATE EXTENSION IF NOT EXISTS postgis;
#
# 4. Update DATABASE_URL with your actual credentials:
#    - postgresql://postgres:YOUR_PASSWORD@localhost:5432/disaster_response
#
# 5. Initialize the database schema:
#    - Run: alembic upgrade head
#    # Or manually: python -c "from app.database.models import Base; Base.metadata.create_all(bind=engine)"
#
# 6. Start the backend:
#    - uvicorn app.main:app --host 127.0.0.1 --port 8000
#
# ============================================================
# Optional: SQLite Development Fallback (no PostGIS support)
# ============================================================
# For development without PostgreSQL, you can use SQLite by setting:
# DATABASE_URL=sqlite:///./disaster_response.db
# Note: Geometry/Location fields will be stored as text coordinates rather than PostGIS points.
# The interactive map and spatial queries will not work with SQLite.